# Text to speech venv (<root>/venvs/localgen-tts): Kokoro-82M on the CPU.
# The MCP server never imports these; it runs src/localgen_mcp/tts_runner.py with this venv's Python.
# Regenerate the lock (setup/tts-requirements.lock) with:
#   uv pip compile setup/tts-requirements.in --python-version 3.12 --generate-hashes \
#     --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple \
#     --index-strategy unsafe-best-match -o setup/tts-requirements.lock
